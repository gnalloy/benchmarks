{
  "name": "gnalloy http1 parity matrix",
  "notes": "HTTP/1.1 keep-alive 对标矩阵。Gnalloy 固定经过 transport、Channel/Pipeline、codec-http1 和业务 Handler；Netty 和 fasthttp 使用各自正式 HTTP 实现。gnet、netpoll 不提供 HTTP codec，明确标记 N/A。",
  "variables": {
    "REPO_ROOT": ".",
    "CONNECTIONS": "128",
    "MESSAGES": "10000",
    "LATENCY_SAMPLE_RATE": "128",
    "WARMUP_MESSAGES": "1000",
    "GNALLOY_HTTP1_READ_BUFFER_SIZE": "384",
    "GNALLOY_BENCH": "./benchmarks/external/bin/gnalloy-bench",
    "NETTY_BENCH_JAR": "./benchmarks/external/bin/netty-bench.jar",
    "FASTHTTP_BENCH": "./benchmarks/external/bin/fasthttp-bench"
  },
  "scenarios": [
    {
      "name": "gnalloy http1 128B",
      "framework": "gnalloy",
      "protocol": "http1",
      "backend": "default",
      "payload": "128B",
      "warmup": 1,
      "repeat": 3,
      "workDir": "${REPO_ROOT}",
      "command": ["${GNALLOY_BENCH}", "-protocol", "http1", "-read-buffer-size", "${GNALLOY_HTTP1_READ_BUFFER_SIZE}", "-payload", "128", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["local", "parity-harness", "http1", "payload-128"]
    },
    {
      "name": "gnalloy http1 1KiB",
      "framework": "gnalloy",
      "protocol": "http1",
      "backend": "default",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "workDir": "${REPO_ROOT}",
      "command": ["${GNALLOY_BENCH}", "-protocol", "http1", "-read-buffer-size", "${GNALLOY_HTTP1_READ_BUFFER_SIZE}", "-payload", "1024", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["local", "parity-harness", "http1", "payload-1024"]
    },
    {
      "name": "netty http1 128B",
      "framework": "netty",
      "protocol": "http1",
      "backend": "default",
      "payload": "128B",
      "warmup": 1,
      "repeat": 3,
      "command": ["java", "-jar", "${NETTY_BENCH_JAR}", "--protocol", "http1", "--backend", "nio", "--payload", "128", "--connections", "${CONNECTIONS}", "--messages", "${MESSAGES}", "--latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "--warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["external", "netty", "http1", "payload-128"]
    },
    {
      "name": "netty http1 1KiB",
      "framework": "netty",
      "protocol": "http1",
      "backend": "default",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "command": ["java", "-jar", "${NETTY_BENCH_JAR}", "--protocol", "http1", "--backend", "nio", "--payload", "1024", "--connections", "${CONNECTIONS}", "--messages", "${MESSAGES}", "--latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "--warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["external", "netty", "http1", "payload-1024"]
    },
    {
      "name": "fasthttp http1 128B",
      "framework": "fasthttp",
      "protocol": "http1",
      "backend": "net",
      "payload": "128B",
      "warmup": 1,
      "repeat": 3,
      "command": ["${FASTHTTP_BENCH}", "-protocol", "http1", "-payload", "128", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["external", "fasthttp", "http1", "payload-128"]
    },
    {
      "name": "fasthttp http1 1KiB",
      "framework": "fasthttp",
      "protocol": "http1",
      "backend": "net",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "command": ["${FASTHTTP_BENCH}", "-protocol", "http1", "-payload", "1024", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["external", "fasthttp", "http1", "payload-1024"]
    },
    {
      "name": "gnet http1 unsupported",
      "framework": "gnet",
      "protocol": "http1",
      "backend": "unsupported",
      "skip": true,
      "skipReason": "gnet does not provide an HTTP codec; benchmark-owned parsing is prohibited",
      "tags": ["external", "gnet", "http1", "unsupported"]
    },
    {
      "name": "netpoll http1 unsupported",
      "framework": "netpoll",
      "protocol": "http1",
      "backend": "unsupported",
      "skip": true,
      "skipReason": "CloudWeGo netpoll does not provide an HTTP codec; benchmark-owned parsing is prohibited",
      "tags": ["external", "netpoll", "http1", "unsupported"]
    }
  ]
}
